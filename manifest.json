{
  "manifest_version": 3,
  "name": "AI Studio Git Sync",
  "version": "1.0",
  "description": "Sync your GitHub repo changes into AI Studio automatically",
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": [
    "https://aistudio.google.com/*",
    "https://alkalimakersuite-pa.clients6.google.com/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://aistudio.google.com/apps/*"],
      "js": ["interceptor.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://aistudio.google.com/apps/*"],
      "js": [
        "utils/auth.js",
        "utils/github.js",
        "utils/aistudio.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
